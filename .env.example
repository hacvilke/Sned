# ===========================================================================
# File Transfer — environment configuration
# Everything is optional for local development; on Vercel you must configure
# ONE signalling store or sessions cannot be shared between requests.
# ===========================================================================

# ---------------------------------------------------------------------------
# Signalling store — pick ONE (recommended: Upstash Redis)
# ---------------------------------------------------------------------------
# Option A: Upstash Redis. Add "Upstash" from the Vercel Marketplace, or create
# a database at https://console.upstash.com and copy the REST URL + token.
# The free tier is comfortably enough: only SDP/ICE messages are stored.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Option B: Vercel Blob. Create a Blob store in the Vercel dashboard and copy
# the token. Only tiny JSON signalling documents are written, never file bytes.
BLOB_READ_WRITE_TOKEN=
# 'private' (default, recommended) or 'public'
# BLOB_SIGNALLING_ACCESS=private

# Force a specific store instead of auto-detecting: redis | blob | memory
# SIGNAL_STORE=

# ---------------------------------------------------------------------------
# Session and transfer limits
# ---------------------------------------------------------------------------
# How long a session code stays valid (seconds). Default 3600 (1 hour).
# ROOM_TTL_SECONDS=3600
# Maximum size per file. Accepts bytes or a unit suffix (500MB, 1GB). Default 1GB.
# MAX_FILE_BYTES=1GB
# Maximum files queued per session. Default 50.
# MAX_FILES_PER_SESSION=50

# ---------------------------------------------------------------------------
# Rate limits (per IP address)
# ---------------------------------------------------------------------------
# Preset: strict | balanced | relaxed. Default balanced:
#   5 sessions/hour, 20 joins/hour, 20 files sent/hour, 60 files received/hour
# RATE_LIMIT_PRESET=balanced
# Any single bucket can be overridden (requests per hour):
# RATE_LIMIT_ROOMS=5
# RATE_LIMIT_JOIN=20
# RATE_LIMIT_UPLOAD=20
# RATE_LIMIT_DOWNLOAD=60
# RATE_LIMIT_SIGNALWRITE=300
# RATE_LIMIT_SIGNALREAD=5400
# RATE_LIMIT_CLOSE=20
# RATE_LIMIT_CONFIG=120

# ---------------------------------------------------------------------------
# WebRTC ICE servers
# ---------------------------------------------------------------------------
# Comma separated. Public STUN is enough for most home/office networks.
# STUN_URL=stun:stun.l.google.com:19302
# A TURN relay is required when both devices sit behind symmetric NATs
# (typical for mobile networks). Credentials are only released to clients that
# present a valid session code.
# TURN_URL=turn:relay.example.com:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=

# ---------------------------------------------------------------------------
# Vercel Cron (see vercel.json) — protects /api/cron/cleanup
# ---------------------------------------------------------------------------
# CRON_SECRET=
