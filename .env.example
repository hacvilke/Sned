# ---------------------------------------------------------------------------
# Required for real transfers on Vercel.
# Create a store with `npx vercel blob stores create`, then link it:
#   npx vercel env add BLOB_READ_WRITE_TOKEN
# Without it the app falls back to in-memory storage capped at MAX_DEV_FILE_BYTES.
# ---------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# Required for rate limits that actually hold across serverless instances.
# Create an Upstash Redis database and copy the REST URL and token.
# Without it, limits are enforced per instance only - much weaker.
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Guards /api/cron/cleanup. Vercel sends it automatically on scheduled runs.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Tunables. Every value below shows its default. Uncomment to change.
# ---------------------------------------------------------------------------
# MAX_FILE_BYTES=262144000
# MAX_BATCH_BYTES=1073741824
# MAX_FILES_PER_BATCH=50
# BATCHES_PER_MINUTE=8
# UPLOADS_PER_MINUTE=20
# UPLOADS_PER_DAY=300
# BYTES_PER_DAY=5368709120
# DOWNLOADS_PER_MINUTE=60
# SHARE_READS_PER_MINUTE=120
# TTL_HOURS=24
# UPLOAD_TOKEN_SECONDS=1800
# MAX_DEV_FILE_BYTES=26214400
# UPLOAD_CONCURRENCY=2
# CODE_LENGTH=6
